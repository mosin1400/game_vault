{
  "private": true,
  "name": "game-vault-theia",
  "version": "1.0.0",
  "license": "EPL-2.0",
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "Game Vault Studio",
        "defaultTheme": "dark",
        "defaultIconTheme": "vs-seti",
        "preferences": {
          "files.enableTrash": false,
          "security.workspace.trust.enabled": false,
          "editor.fontFamily": "JetBrains Mono, Consolas, monospace",
          "editor.fontSize": 14,
          "workbench.colorTheme": "Dark Modern"
        }
      }
    }
  },
  "dependencies": {
    "@theia/bulk-edit": "^1.74.0",
    "@theia/core": "1.74.0",
    "@theia/editor": "1.74.0",
    "@theia/file-search": "1.74.0",
    "@theia/filesystem": "1.74.0",
    "@theia/markers": "1.74.0",
    "@theia/messages": "1.74.0",
    "@theia/monaco": "1.74.0",
    "@theia/navigator": "1.74.0",
    "@theia/output": "1.74.0",
    "@theia/preferences": "1.74.0",
    "@theia/process": "1.74.0",
    "@theia/scm": "1.74.0",
    "@theia/scm-extra": "1.74.0",
    "@theia/search-in-workspace": "1.74.0",
    "@theia/terminal": "1.74.0",
    "@theia/vsx-registry": "1.74.0",
    "@theia/workspace": "1.74.0",
    "game-vault-theia-extension": "file:./gv-extension",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@theia/cli": "1.74.0"
  },
  "scripts": {
    "build": "theia rebuild:browser && theia build --mode production",
    "start": "theia start --hostname=127.0.0.1 --port=3010"
  }
}
